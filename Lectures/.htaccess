# Deny direct HTTP access to all files in this directory.
# Files are served exclusively through php/download_lecture_material.php
# and php/preview_lecture_material.php.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
